{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run_metadata.schema.json",
  "title": "ASR Eval Run Metadata",
  "description": "Captures every condition needed to reproduce an evaluation run.",
  "type": "object",
  "required": ["run_id", "stage", "owner", "started_at", "status", "git", "dataset", "runner"],
  "additionalProperties": true,
  "properties": {
    "run_id":     { "type": "string" },
    "stage":      { "type": "string", "enum": ["baseline", "llm_fixed_input", "end_to_end"] },
    "owner":      { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at":   { "type": ["string", "null"], "format": "date-time" },
    "status":     { "type": "string", "enum": ["running", "completed", "failed"] },
    "git": {
      "type": "object",
      "properties": {
        "commit":   { "type": ["string", "null"] },
        "branch":   { "type": ["string", "null"] },
        "dirty":    { "type": ["boolean", "null"] },
        "repo_url": { "type": ["string", "null"] }
      }
    },
    "dataset": {
      "type": "object",
      "properties": {
        "name":             { "type": ["string", "null"] },
        "version":          { "type": ["string", "null"] },
        "manifest":         { "type": "string" },
        "manifest_sha256":  { "type": ["string", "null"] }
      }
    },
    "runner": {
      "type": "object",
      "properties": {
        "config_path":      { "type": "string" },
        "command":          { "type": "string" },
        "hostname":         { "type": ["string", "null"] },
        "python_version":   { "type": ["string", "null"] },
        "container_image":  { "type": ["string", "null"] }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "asr": {
          "type": ["object", "null"],
          "properties": {
            "name":      { "type": "string" },
            "version":   { "type": ["string", "null"] },
            "provider":  { "type": ["string", "null"] },
            "device":    { "type": ["string", "null"] },
            "precision": { "type": ["string", "null"] }
          }
        },
        "diarization": {
          "type": ["object", "null"],
          "properties": {
            "name":     { "type": "string" },
            "version":  { "type": ["string", "null"] },
            "provider": { "type": ["string", "null"] },
            "device":   { "type": ["string", "null"] }
          }
        },
        "llm": {
          "type": ["object", "null"],
          "properties": {
            "name":        { "type": "string" },
            "provider":    { "type": ["string", "null"] },
            "version":     { "type": ["string", "null"] },
            "temperature": { "type": ["number", "null"] },
            "max_tokens":  { "type": ["integer", "null"] }
          }
        }
      }
    },
    "decoding_params":    { "type": "object" },
    "diarization_params": { "type": "object" },
    "prompts":            { "type": "object" },
    "cost_config":        { "type": "object" },
    "artifacts":          { "type": "object" },
    "baseline_run_id":    { "type": ["string", "null"] },
    "notes":              { "type": ["string", "null"] }
  }
}
