# SSS data — results are historic artifacts; exclude from source control
# Drop these lines if you want to commit sample data
*/data/results/*.json
*/data/runs/*.yaml

# But keep the directory skeletons
!*/data/results/.gitkeep
!*/data/runs/.gitkeep
!*/data/ground_truth/.gitkeep
!*/data/transcriptions/.gitkeep
